  ∃ S,
    S.Countable ∧
      ∀ (r : ℝ),
        0 < r →
          r ∉ S →
            ∀ (p : ℝ),
              ↑m < p →
                (MaximumModulus.InversePairs q (MaximumModulus.reflection q) (↑r ^ 2) ↑p).Finite ∧
                  (MaximumModulus.InversePairs q (MaximumModulus.reflection q) (↑r ^ 2) ↑p).ncard ≤ B
