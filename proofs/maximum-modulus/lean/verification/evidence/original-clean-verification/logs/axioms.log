@[expose] def MaximumModulus.Entire : (ℂ → ℂ) → Prop :=
fun f => Differentiable ℂ f
@[expose] def MaximumModulus.IsMonomial : (ℂ → ℂ) → Prop :=
fun f => ∃ c m, c ≠ 0 ∧ ∀ (z : ℂ), f z = c * z ^ m
@[expose] def MaximumModulus.MaxPoints : (ℂ → ℂ) → ℝ → Set ℂ :=
fun f r => {z | ‖z‖ = r ∧ ∀ (w : ℂ), ‖w‖ = r → ‖f w‖ ≤ ‖f z‖}
@[expose] def MaximumModulus.GoodRadius : (ℂ → ℂ) → ℕ → ℝ → Prop :=
fun f B r => (MaximumModulus.MaxPoints f r).Finite ∧ (MaximumModulus.MaxPoints f r).ncard ≤ B
@[expose] def MaximumModulus.CofinalBound : (ℂ → ℂ) → ℕ → Prop :=
fun f B => ∀ (R : ℝ), 0 < R → ∃ r, R < r ∧ MaximumModulus.GoodRadius f B r
@[expose] def MaximumModulus.AllRadiiStatement : Prop :=
∀ (f : ℂ → ℂ), MaximumModulus.Entire f → f ≠ 0 → ¬MaximumModulus.IsMonomial f → ∃ B, MaximumModulus.CofinalBound f B
@[expose] def MaximumModulus.AlmostEverywhereBoundStatement : Prop :=
∀ (f : ℂ → ℂ),
