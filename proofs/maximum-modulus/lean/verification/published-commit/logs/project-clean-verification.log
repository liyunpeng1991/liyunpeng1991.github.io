          ∃ ε,
            0 < ε ∧
              ∀ (s p : ℂ),
                s ≠ 0 →
                  ‖s‖ < ε ^ 2 →
                    (MaximumModulus.InversePairs (MaximumModulus.normalizedLogDerivative m g)
                          (MaximumModulus.reflection (MaximumModulus.normalizedLogDerivative m g)) s p).Finite ∧
                      (MaximumModulus.InversePairs (MaximumModulus.normalizedLogDerivative m g)
                            (MaximumModulus.reflection (MaximumModulus.normalizedLogDerivative m g)) s p).ncard ≤
                        2 * analyticOrderNatAt (fun z => MaximumModulus.normalizedLogDerivative m g z - ↑m) 0 :=
