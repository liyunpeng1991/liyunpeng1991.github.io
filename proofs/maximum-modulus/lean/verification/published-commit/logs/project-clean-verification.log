      ¬MaximumModulus.IsMonomial f →
        (∀ (z : ℂ), f z = z ^ m * g z) →
          MaximumModulus.PositiveProductFiberBound (MaximumModulus.normalizedLogDerivative m g) m B →
            MaximumModulus.CofinalBound f B :=
