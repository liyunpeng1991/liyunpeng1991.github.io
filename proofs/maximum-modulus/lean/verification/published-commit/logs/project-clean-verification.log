theorem MaximumModulus.analytic_local_valence : ∀ {A : ℂ → ℂ},
  AnalyticAt ℂ A 0 →
    analyticOrderAt (fun z => A z - A 0) 0 ≠ ⊤ →
      0 < analyticOrderNatAt (fun z => A z - A 0) 0 ∧
        ∃ ε,
          0 < ε ∧
            ∀ (p : ℂ),
              {z | ‖z‖ < ε ∧ A z = p}.Finite ∧
                {z | ‖z‖ < ε ∧ A z = p}.ncard ≤ analyticOrderNatAt (fun z => A z - A 0) 0 :=
